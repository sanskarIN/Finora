* text=auto

# Repository source/config should remain LF for cross-platform diffs.
*.cs text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.resx text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.svg text eol=lf

# PowerShell is cross-platform here; keep LF as well.
*.ps1 text eol=lf

# Binary/image/archive/package types.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.apk binary
*.aab binary
*.ipa binary
*.msix binary
*.msixbundle binary
*.pfx binary
*.p12 binary
*.jks binary
*.keystore binary
