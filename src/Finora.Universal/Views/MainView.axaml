<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Finora.Universal.ViewModels"
             x:Class="Finora.Universal.Views.MainView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <Grid Margin="32" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" MaxWidth="920" HorizontalAlignment="Center">
      <TextBlock Grid.Row="0" Text="{Binding ProductName}" FontSize="40" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Margin="0,6,0,24" Text="Local-first finance across desktop, mobile, and web-capable hosts" FontSize="18" TextWrapping="Wrap" />

      <Border Grid.Row="2" Padding="20" CornerRadius="14" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="Platform runtime" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PlatformName}" FontSize="17" />
          <TextBlock Text="{Binding StorageDescription}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AccountSummary}" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Margin="0,18,0,0" Padding="20" CornerRadius="14" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="Cross-platform architecture" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Android · iOS/iPadOS · Windows · macOS · Linux · Web/WASM · ChromeOS paths" TextWrapping="Wrap" />
          <TextBlock Text="The shared domain and application layers remain platform-neutral. Native and browser hosts own storage, notifications, biometrics, file access, and other platform capabilities." TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="4" Margin="0,22,0,0" Text="{Binding RepositoryUrl}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{Binding Attribution}" FontWeight="SemiBold" />
    </Grid>
  </ScrollViewer>
</UserControl>
