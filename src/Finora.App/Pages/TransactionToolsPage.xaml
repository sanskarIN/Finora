<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.TransactionToolsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             xmlns:domain="clr-namespace:Finora.Domain;assembly=Finora.Domain"
             x:DataType="local:TransactionToolsViewModel"
             Title="{DynamicResource Text.TransactionToolsTitle}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.TransactionToolsTitle}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="{DynamicResource Text.TransactionToolsNotice}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><DatePicker Date="{Binding FromDate}" SemanticProperties.Description="{DynamicResource Text.TransactionToolsStartDateDescription}" /><DatePicker Grid.Column="1" Date="{Binding ToDate}" SemanticProperties.Description="{DynamicResource Text.TransactionToolsEndDateDescription}" /></Grid>
    <Button Text="{DynamicResource Text.TransactionToolsRefreshPeriod}" Command="{Binding LoadCommand}" />
    <Label Text="{DynamicResource Text.TransactionToolsBulkCategorization}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Picker Title="{DynamicResource Text.TransactionToolsNewCategory}" ItemsSource="{Binding Categories}" SelectedItem="{Binding BulkCategory}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:Category" /></Picker.ItemDisplayBinding></Picker>
    <CollectionView ItemsSource="{Binding Transactions}" EmptyView="{DynamicResource Text.TransactionToolsNoTransactions}" HeightRequest="320">
      <CollectionView.ItemTemplate><DataTemplate x:DataType="local:ToolTransactionItem"><Grid Padding="8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><CheckBox IsChecked="{Binding IsSelected}" /><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Merchant}" FontAttributes="Bold" /><Label Text="{Binding AccountName}" FontSize="12" /><Label Text="{Binding CategoryName}" FontSize="12" /><Label Text="{Binding OccurredAtUtc, StringFormat='{0:g}'}" FontSize="12" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="{Binding Type}" HorizontalTextAlignment="End" /><Label HorizontalTextAlignment="End"><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
    <Button Text="{DynamicResource Text.TransactionToolsApplyCategory}" Command="{Binding BulkCategorizeCommand}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.TransactionToolsExportCsv}" Clicked="OnExportSelectedCsvClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.TransactionToolsExportPdf}" Clicked="OnExportSelectedPdfClicked" /></Grid>
    <Label Text="{DynamicResource Text.TransactionToolsDuplicateReview}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Button Text="{DynamicResource Text.TransactionToolsScanDuplicates}" Command="{Binding ScanDuplicatesCommand}" />
    <CollectionView x:Name="DuplicateList" ItemsSource="{Binding Duplicates}" SelectionMode="Single" SelectionChanged="OnDuplicateSelected" EmptyView="{DynamicResource Text.TransactionToolsNoDuplicates}" HeightRequest="300">
      <CollectionView.ItemTemplate><DataTemplate x:DataType="application:DuplicateTransactionCandidate"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Merchant}" FontAttributes="Bold" /><Label Text="{Binding AccountName}" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.TransactionToolsAmountPrefix}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.TransactionToolsDatePrefix}" /><Label Text="{Binding OccurredAtUtc, StringFormat='{0:g}'}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.TransactionToolsSimilarityPrefix}" /><Label Text="{Binding ConfidencePercent, StringFormat='{0}%'}" /></HorizontalStackLayout><Label Text="{DynamicResource Text.TransactionToolsDuplicateHelp}" FontSize="12" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
    <Label Text="{Binding Status}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
