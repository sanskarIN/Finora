<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.SettingsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Settings">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Settings" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="Appearance &amp; accessibility" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Picker Title="Theme" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" /><Grid ColumnDefinitions="*,Auto"><Label Text="Reduced motion" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ReducedMotion}" SemanticProperties.Description="Reduce non-essential Finora motion" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Larger interface" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding LargerInterface}" SemanticProperties.Description="Use larger Finora interface text and controls" /></Grid>
    <Label Text="Privacy &amp; security" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Grid ColumnDefinitions="*,Auto"><Label Text="Privacy mode" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding PrivacyMode}" SemanticProperties.Description="Hide finance amounts while privacy mode is enabled" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Hide amounts on launch" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding HideAmounts}" SemanticProperties.Description="Hide finance amounts when Finora opens" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Protect sensitive screen capture where supported" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding SensitiveScreenProtection}" Toggled="OnSensitiveScreenToggled" SemanticProperties.Description="Block screenshots and screen capture on supported platforms" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Biometric / Windows Hello unlock" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding BiometricUnlock}" Toggled="OnBiometricToggled" SemanticProperties.Description="Allow biometric unlock while keeping PIN fallback" /></Grid><Label x:Name="SecurityCapabilityLabel" FontSize="12" />
    <Label Text="Finance preferences" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Entry Text="{Binding Currency}" Placeholder="Default currency" MaxLength="8" SemanticProperties.Description="Default currency code" /><Entry Text="{Binding Locale}" Placeholder="Locale, for example en-IN or hi-IN" MaxLength="20" SemanticProperties.Description="Locale used for dates and number formatting" /><Label Text="Number and date formatting follows the selected locale. Finora ships English first and is localization-ready for Hindi and additional languages." FontSize="12" /><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="4"><Label Text="Format preview" FontAttributes="Bold" /><Label Text="{Binding NumberFormatPreview}" SemanticProperties.Description="Preview of the selected currency, number, and date formatting" /></VerticalStackLayout></Border><Label Text="Financial month start day" /><Stepper Minimum="1" Maximum="28" Value="{Binding MonthStartDay}" /><Label Text="{Binding MonthStartDay}" /><Picker Title="Default account" ItemsSource="{Binding Accounts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding DefaultAccount}" /><Picker Title="Default transaction type" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding DefaultTransactionType}" />
    <Label Text="Notifications &amp; reminders" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Grid ColumnDefinitions="*,Auto"><Label Text="Enable local notifications" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" SemanticProperties.Description="Enable privacy-safe local Finora reminders" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Weekly backup reminder" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding BackupReminders}" SemanticProperties.Description="Remind me locally to create an encrypted backup" /></Grid><Button Text="Request notification permission &amp; sync reminders" Clicked="OnRequestNotificationsClicked" /><Label x:Name="NotificationStatusLabel" FontSize="12" />
    <Label Text="Receipt storage" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Label Text="Preferred receipt image quality" /><Stepper Minimum="40" Maximum="100" Increment="5" Value="{Binding ReceiptImageQuality}" /><Label Text="{Binding ReceiptImageQuality, StringFormat='{0}%'}" /><Label x:Name="StorageUsageLabel" Text="Calculating local attachment storage…" /><Button Text="Clean orphaned receipt files" Clicked="OnCleanupAttachmentsClicked" />
    <Label Text="Backup &amp; export" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Entry x:Name="BackupPasswordEntry" Placeholder="Backup password (8+ characters)" IsPassword="True" MaxLength="128" ClearButtonVisibility="WhileEditing" SemanticProperties.Description="Backup password. This value is masked, kept only in memory for the selected operation, and cleared after use." />
    <Label Text="Enter the password immediately before creating or restoring a backup. Finora cannot recover a forgotten backup password and does not save it." FontSize="12" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Create encrypted backup" Clicked="OnCreateBackupClicked" /><Button Grid.Column="1" Text="Restore backup" Clicked="OnRestoreBackupClicked" /></Grid><Button Text="Export sanitized diagnostic log" Clicked="OnExportLogClicked" /><Label Text="Backups are created only when you request them and are never uploaded automatically." FontSize="12" />
    <Label Text="App lock" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Label Text="Auto-lock after inactivity (minutes)" /><Stepper Minimum="1" Maximum="60" Value="{Binding AutoLockMinutes}" /><Label Text="{Binding AutoLockMinutes, StringFormat='After {0} minute(s)'}" />
    <Entry x:Name="NewPinEntry" Placeholder="New PIN (4–12 digits)" IsPassword="True" Keyboard="Numeric" MaxLength="12" ClearButtonVisibility="WhileEditing" SemanticProperties.Description="New Finora app lock PIN, masked" />
    <Entry x:Name="ConfirmPinEntry" Placeholder="Confirm new PIN" IsPassword="True" Keyboard="Numeric" MaxLength="12" ClearButtonVisibility="WhileEditing" SemanticProperties.Description="Confirm the new Finora app lock PIN, masked" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Set / change PIN" Clicked="OnSetPinClicked" /><Button Grid.Column="1" Text="Remove PIN" Clicked="OnRemovePinSafelyClicked" /></Grid>
    <Label Text="Data controls" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Button Text="Manage categories &amp; tags" Clicked="OnCategoriesClicked" /><Button Text="Revisit onboarding" Clicked="OnOnboardingClicked" /><Button Text="Delete all local finance data" BackgroundColor="{StaticResource Danger}" Clicked="OnDeleteAllFinanceDataClicked" />
    <Label Text="About" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="6"><Label Text="Finora 0.2.0 (2)" FontAttributes="Bold"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnVersionTapped" /></Label.GestureRecognizers></Label><Label Text="Made by the Sanskar" /><Label Text=".NET MAUI · C# · XAML · SQLite · MVVM" /><Button Text="Open-source repository" Clicked="OnRepositoryClicked" /><Button Text="Creator GitHub profile" Clicked="OnProfileClicked" /><Button Text="Business: sanskarin@outlook.in" Clicked="OnBusinessEmailClicked" /><Button Text="Support: supportramsandesh@gmail.com" Clicked="OnSupportEmailClicked" /><Label Text="Licensed under Apache-2.0." /><Grid ColumnDefinitions="*,*,*" ColumnSpacing="5"><Button Text="Privacy" Clicked="OnPrivacyClicked" /><Button Grid.Column="1" Text="Terms" Clicked="OnTermsClicked" /><Button Grid.Column="2" Text="Notices" Clicked="OnNoticesClicked" /></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="5"><Button Text="Contributing" Clicked="OnContributingClicked" /><Button Grid.Column="1" Text="Security" Clicked="OnSecurityGuideClicked" /><Button Grid.Column="2" Text="Support guide" Clicked="OnSupportGuideClicked" /></Grid></VerticalStackLayout></Border>
    <VerticalStackLayout x:Name="DeveloperPanel" IsVisible="False" Spacing="10"><Label Text="Developer options" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Button Text="Show database schema version" Clicked="OnSchemaVersionClicked" /><Button Text="Run local data integrity check" Clicked="OnIntegrityCheckClicked" /><Button Text="Reset to synthetic sample data" Clicked="OnResetSampleDataClicked" /><Button Text="Show feature flags" Clicked="OnFeatureFlagsClicked" /><Button Text="Simulate reminder sync" Clicked="OnSimulateNotificationsClicked" /><Grid ColumnDefinitions="*,Auto"><Label Text="Local premium demo flag" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding LocalPremiumDemoEnabled}" /></Grid><Label Text="The premium flag is a local development/demo capability only and is not tamper-proof commercial licensing." /></VerticalStackLayout>
    <Label Text="Local premium flags are not secure commercial licensing. A future store/server integration is required for reliable paid entitlement validation." /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" SemanticProperties.LiveSetting="Polite" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
