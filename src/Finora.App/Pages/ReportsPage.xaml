<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ReportsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Reports">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Reports" Style="{StaticResource Title}" />
    <Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border>
    <Label Text="Spending by category" Style="{StaticResource SectionTitle}" />
    <Label Text="The textual list below is the accessibility-safe representation of the chart data." />
    <CollectionView ItemsSource="{Binding Categories}" EmptyView="No category spending for this month." HeightRequest="260">
      <CollectionView.ItemTemplate><DataTemplate><Grid Padding="10" ColumnDefinitions="*,Auto"><Label Text="{Binding CategoryName}" /><Label Grid.Column="1" Text="{Binding AmountMinor, StringFormat='{0} minor'}" /></Grid></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Export CSV" Clicked="OnExportCsvClicked" /><Button Grid.Column="1" Text="Export PDF" Clicked="OnExportPdfClicked" /></Grid>
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
