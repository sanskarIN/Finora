<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ReportsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" Title="Reports">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Reports" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><DatePicker Date="{Binding FromDate}" SemanticProperties.Description="Report start date" /><DatePicker Grid.Column="1" Date="{Binding ToDate}" SemanticProperties.Description="Report end date" /></Grid>
    <Button Text="Refresh reports" Command="{Binding RefreshCommand}" />
    <Label Text="{Binding ReportingCurrencyNotice}" FontSize="12" SemanticProperties.Description="Reporting currency, privacy, and multi-currency behavior" />
    <Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border>

    <Label Text="Spending by category" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding CategoryPoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="{Binding CategorySummary}" />
    <Label Text="{Binding CategorySummary}" />

    <Label Text="Income versus expense" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding IncomeExpensePoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="{Binding IncomeExpenseSummary}" />
    <Label Text="{Binding IncomeExpenseSummary}" />

    <Label Text="12-month net-change comparison" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding MonthlyNetPoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="Monthly net-change comparison chart; equivalent values follow in a list" />
    <CollectionView ItemsSource="{Binding MonthlyNetRows}" HeightRequest="180" EmptyView="No monthly comparison data.">
      <CollectionView.ItemTemplate><DataTemplate><Grid Padding="6" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Label Text="5-year net-change comparison" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding YearlyNetPoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="Yearly net-change comparison chart; equivalent values follow in a list" />
    <CollectionView ItemsSource="{Binding YearlyNetRows}" HeightRequest="150" EmptyView="No yearly comparison data.">
      <CollectionView.ItemTemplate><DataTemplate><Grid Padding="6" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Label Text="Merchant / payee report" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding MerchantRows}" HeightRequest="260" EmptyView="No merchant data.">
      <CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Merchant}" FontAttributes="Bold" /><Label Text="{Binding TransactionCount, StringFormat='{0} transaction(s)'}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Expense, StringFormat='Spent {0}'}" /><Label Text="{Binding Income, StringFormat='Income {0}'}" /></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Label Text="Budget performance" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding BudgetRows}" HeightRequest="240" EmptyView="No active budgets for the selected date.">
      <CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Planned, StringFormat='Planned {0}'}" /><Label Text="{Binding Actual, StringFormat='Actual {0}'}" /><Label Text="{Binding Variance, StringFormat='Variance {0}'}" /></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Label Text="Recurring obligations" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding RecurringRows}" HeightRequest="260" EmptyView="No recurring obligations.">
      <CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout Spacing="4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Type}" /><Label Text="{Binding Status, StringFormat='Status: {0}'}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Amount}" FontAttributes="Bold" /><Label Text="{Binding Currency}" HorizontalTextAlignment="End" /></VerticalStackLayout></Grid><Label Text="{Binding NextDue, StringFormat='Next due: {0}'}" /><Label Text="{Binding EndDate, StringFormat='End: {0}'}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Label Text="Savings progress" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding SavingsRows}" HeightRequest="260" EmptyView="No savings goals.">
      <CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout Spacing="4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Status}" /><Label Text="{Binding TargetDate, StringFormat='Target date: {0}'}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Percent}" FontAttributes="Bold" HorizontalTextAlignment="End" /><Label Text="{Binding Currency}" HorizontalTextAlignment="End" /></VerticalStackLayout></Grid><Label Text="{Binding Current, StringFormat='Current: {0}'}" /><Label Text="{Binding Target, StringFormat='Target: {0}'}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Label Text="Account balance trends" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding AccountTrendRows}" HeightRequest="260" EmptyView="No account trend data.">
      <CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding AccountName}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /><CollectionView ItemsSource="{Binding Points}" HeightRequest="120"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="4" ColumnDefinitions="*,Auto"><Label Text="{Binding Date}" /><Label Grid.Column="1" Text="{Binding Balance}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Export CSV" Clicked="OnExportCsvClicked" /><Button Grid.Column="1" Text="Export PDF" Clicked="OnExportPdfClicked" /></Grid>
    <Label Text="Quantitative charts are hidden when privacy mode hides amounts. Otherwise, every chart has equivalent text or tabular values and signed charts use a true zero baseline." FontSize="12" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
