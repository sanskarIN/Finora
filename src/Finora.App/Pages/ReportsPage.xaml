<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ReportsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" x:DataType="local:ReportsViewModel" Title="{DynamicResource Text.Reports}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.Reports}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><DatePicker Date="{Binding FromDate}" SemanticProperties.Description="{DynamicResource Text.ReportStartDateDescription}" /><DatePicker Grid.Column="1" Date="{Binding ToDate}" SemanticProperties.Description="{DynamicResource Text.ReportEndDateDescription}" /></Grid>
    <Button Text="{DynamicResource Text.ReportRefresh}" Command="{Binding RefreshCommand}" />
    <Label Text="{Binding ReportingCurrencyNotice}" FontSize="12" SemanticProperties.Description="{DynamicResource Text.ReportCurrencyBehaviorDescription}" />
    <Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border>
    <Label Text="{DynamicResource Text.ReportSpendingByCategory}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding CategoryPoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="{Binding CategorySummary}" />
    <Label Text="{Binding CategorySummary}" />
    <Label Text="{DynamicResource Text.ReportIncomeVersusExpense}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding IncomeExpensePoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="{Binding IncomeExpenseSummary}" />
    <Label Text="{Binding IncomeExpenseSummary}" />
    <Label Text="{DynamicResource Text.ReportMonthlyNetComparison}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding MonthlyNetPoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="{DynamicResource Text.ReportMonthlyChartDescription}" />
    <CollectionView ItemsSource="{Binding MonthlyNetRows}" HeightRequest="180" EmptyView="{DynamicResource Text.ReportNoMonthlyData}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:ReportDisplayPoint"><Grid Padding="6" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.ReportYearlyNetComparison}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <local:ReportBarChartView ItemsSource="{Binding YearlyNetPoints}" IsVisible="{Binding AmountsVisible}" SemanticProperties.Description="{DynamicResource Text.ReportYearlyChartDescription}" />
    <CollectionView ItemsSource="{Binding YearlyNetRows}" HeightRequest="150" EmptyView="{DynamicResource Text.ReportNoYearlyData}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:ReportDisplayPoint"><Grid Padding="6" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.ReportMerchantPayee}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding MerchantRows}" HeightRequest="260" EmptyView="{DynamicResource Text.ReportNoMerchantData}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:MerchantReportDisplayItem"><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Merchant}" FontAttributes="Bold" /><HorizontalStackLayout Spacing="4"><Label Text="{Binding TransactionCount}" /><Label Text="{DynamicResource Text.Transactions}" /></HorizontalStackLayout></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportSpent}" /><Label Text="{Binding Expense}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.Income}" /><Label Text="{Binding Income}" /></HorizontalStackLayout></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.ReportBudgetPerformance}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding BudgetRows}" HeightRequest="240" EmptyView="{DynamicResource Text.ReportNoActiveBudgets}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:BudgetPerformanceDisplayItem"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportPlanned}" /><Label Text="{Binding Planned}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportActual}" /><Label Text="{Binding Actual}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportVariance}" /><Label Text="{Binding Variance}" /></HorizontalStackLayout></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.ReportRecurringObligations}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding RecurringRows}" HeightRequest="260" EmptyView="{DynamicResource Text.ReportNoRecurringObligations}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:RecurringObligationDisplayItem"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout Spacing="4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Type}" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportStatus}" /><Label Text="{Binding Status}" /></HorizontalStackLayout></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Amount}" FontAttributes="Bold" /><Label Text="{Binding Currency}" HorizontalTextAlignment="End" /></VerticalStackLayout></Grid><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportNextDue}" /><Label Text="{Binding NextDue}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportEnd}" /><Label Text="{Binding EndDate}" /></HorizontalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.ReportSavingsProgress}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding SavingsRows}" HeightRequest="260" EmptyView="{DynamicResource Text.ReportNoSavingsGoals}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SavingsProgressDisplayItem"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout Spacing="4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Status}" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportTargetDate}" /><Label Text="{Binding TargetDate}" /></HorizontalStackLayout></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Percent}" FontAttributes="Bold" HorizontalTextAlignment="End" /><Label Text="{Binding Currency}" HorizontalTextAlignment="End" /></VerticalStackLayout></Grid><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportCurrent}" /><Label Text="{Binding Current}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReportTarget}" /><Label Text="{Binding Target}" /></HorizontalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.ReportAccountBalanceTrends}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding AccountTrendRows}" HeightRequest="260" EmptyView="{DynamicResource Text.ReportNoAccountTrendData}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:AccountBalanceDisplaySeries"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding AccountName}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /><CollectionView ItemsSource="{Binding Points}" HeightRequest="120"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:AccountBalanceDisplayPoint"><Grid Padding="4" ColumnDefinitions="*,Auto"><Label Text="{Binding Date}" /><Label Grid.Column="1" Text="{Binding Balance}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.ReportExportCsv}" Clicked="OnExportCsvClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.ReportExportPdf}" Clicked="OnExportPdfClicked" /></Grid>
    <Label Text="{DynamicResource Text.ReportChartAccessibilityNotice}" FontSize="12" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
