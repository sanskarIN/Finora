<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ReportsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" Title="Reports">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Reports" Style="{StaticResource Title}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><DatePicker Date="{Binding FromDate}" /><DatePicker Grid.Column="1" Date="{Binding ToDate}" /></Grid><Button Text="Refresh reports" Command="{Binding RefreshCommand}" /><Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border>
    <Label Text="Spending by category" Style="{StaticResource SectionTitle}" /><local:ReportBarChartView ItemsSource="{Binding CategoryPoints}" SemanticProperties.Description="{Binding CategorySummary}" /><Label Text="{Binding CategorySummary}" />
    <Label Text="Income versus expense" Style="{StaticResource SectionTitle}" /><local:ReportBarChartView ItemsSource="{Binding IncomeExpensePoints}" SemanticProperties.Description="{Binding IncomeExpenseSummary}" /><Label Text="{Binding IncomeExpenseSummary}" />
    <Label Text="12-month net-change comparison" Style="{StaticResource SectionTitle}" /><local:ReportBarChartView ItemsSource="{Binding MonthlyNetPoints}" /><CollectionView ItemsSource="{Binding MonthlyNetPoints}" HeightRequest="180" EmptyView="No monthly comparison data."><CollectionView.ItemTemplate><DataTemplate><Grid Padding="6" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding ValueMinor, StringFormat='{0} minor'}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Merchant / payee report" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding Merchants}" HeightRequest="260" EmptyView="No merchant data."><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Merchant}" FontAttributes="Bold" /><Label Text="{Binding TransactionCount, StringFormat='{0} transaction(s)'}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding ExpenseMinor, StringFormat='Spent {0} minor'}" /><Label Text="{Binding IncomeMinor, StringFormat='Income {0} minor'}" /></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Budget performance" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding Budgets}" HeightRequest="240" EmptyView="No active budgets."><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding PlannedMinor, StringFormat='Planned {0} minor'}" /><Label Text="{Binding ActualMinor, StringFormat='Actual {0} minor'}" /><Label Text="{Binding VarianceMinor, StringFormat='Variance {0} minor'}" /></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Account balance trends" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding AccountTrends}" HeightRequest="260" EmptyView="No account trend data."><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding AccountName}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /><CollectionView ItemsSource="{Binding Points}" HeightRequest="120"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="4" ColumnDefinitions="*,Auto"><Label Text="{Binding Date}" /><Label Grid.Column="1" Text="{Binding BalanceMinor, StringFormat='{0} minor'}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Export CSV" Clicked="OnExportCsvClicked" /><Button Grid.Column="1" Text="Export PDF" Clicked="OnExportPdfClicked" /></Grid>
    <Label Text="Every chart is accompanied by equivalent text or tabular values for screen-reader access and uses a zero baseline for magnitude bars." FontSize="12" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
