<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.AccountDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             x:DataType="local:AccountDetailViewModel"
             Title="{DynamicResource Text.AccountDetails}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.AccountDetails}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border>
    <Entry Placeholder="{DynamicResource Text.AccountDetailsName}" Text="{Binding Name}" />
    <Picker Title="{DynamicResource Text.Type}" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding Type}" />
    <Entry Placeholder="{DynamicResource Text.IconName}" Text="{Binding Icon}" />
    <Entry Placeholder="{DynamicResource Text.AccountDetailsOptionalColor}" Text="{Binding ColorLabel}" />
    <Entry Placeholder="{DynamicResource Text.OpeningBalance}" Keyboard="Numeric" Text="{Binding OpeningBalance}" SemanticProperties.Description="{DynamicResource Text.OpeningBalanceMajorDescription}" />
    <VerticalStackLayout IsVisible="{Binding IsCreditCard}"><Entry Placeholder="{DynamicResource Text.AccountDetailsCreditLimit}" Keyboard="Numeric" Text="{Binding CreditLimit}" SemanticProperties.Description="{DynamicResource Text.AccountDetailsCreditLimitDescription}" /><Label Text="{DynamicResource Text.AccountDetailsBillingDay}" /><Stepper Minimum="1" Maximum="31" Value="{Binding BillingDay}" /><Label Text="{Binding BillingDay}" /></VerticalStackLayout>
    <Picker Title="{DynamicResource Text.AccountDetailsState}" ItemsSource="{Binding States}" SelectedItem="{Binding State}" />
    <Button Text="{DynamicResource Text.AccountDetailsSave}" Command="{Binding SaveCommand}" />
    <Button Text="{DynamicResource Text.AccountDetailsArchiveRestore}" Command="{Binding ArchiveOrRestoreCommand}" />
    <Button Text="{DynamicResource Text.AccountDetailsReconcile}" Clicked="OnReconcileClicked" />
    <Label Text="{DynamicResource Text.AccountDetailsTransactions}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView x:Name="AccountTransactions" ItemsSource="{Binding Transactions}" SelectionMode="Single" SelectionChanged="OnTransactionSelected" EmptyView="{DynamicResource Text.AccountDetailsNoTransactions}" HeightRequest="360"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:TransactionListItem"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Merchant}" FontAttributes="Bold" /><Label Text="{Binding CategoryName}" /><Label Text="{Binding OccurredAtUtc, StringFormat='{0:g}'}" /></VerticalStackLayout><Label Grid.Column="1"><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{Binding Status}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
