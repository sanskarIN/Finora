<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.TransactionsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application" xmlns:domain="clr-namespace:Finora.Domain;assembly=Finora.Domain" x:DataType="local:TransactionsViewModel" Title="{DynamicResource Text.Transactions}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.Transactions}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><SearchBar Placeholder="{DynamicResource Text.SearchMerchantNoteAccountCategory}" Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.Search}" Command="{Binding SearchCommand}" /></Grid>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Text="{DynamicResource Text.AdvancedFilters}" Command="{Binding ToggleFiltersCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.ClearFilters}" Command="{Binding ClearFiltersCommand}" /></Grid>
    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowAdvancedFilters}"><VerticalStackLayout Spacing="8">
      <Label Text="{DynamicResource Text.AdvancedFilters}" Style="{StaticResource SectionTitle}" />
      <Picker Title="{DynamicResource Text.AccountAll}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding FilterAccount}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
      <Picker Title="{DynamicResource Text.CategoryAll}" ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:Category" /></Picker.ItemDisplayBinding></Picker>
      <Picker Title="{DynamicResource Text.TransactionType}" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding FilterType}" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><VerticalStackLayout><Label Text="{DynamicResource Text.From}" /><DatePicker Date="{Binding FilterFromDate}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{DynamicResource Text.Through}" /><DatePicker Date="{Binding FilterToDate}" /></VerticalStackLayout></Grid>
      <Button Text="{DynamicResource Text.ApplyFilters}" Command="{Binding SearchCommand}" />
    </VerticalStackLayout></Border>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Picker Title="{DynamicResource Text.SortHistory}" ItemsSource="{Binding SortOrders}" SelectedItem="{Binding SortOrder}" SemanticProperties.Description="{DynamicResource Text.SortHistoryDescription}" /><Button Grid.Column="1" Text="{DynamicResource Text.ApplySort}" Command="{Binding SearchCommand}" /></Grid>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.ImportCsv}" Clicked="OnImportClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.Tools}" Clicked="OnToolsClicked" /><Button Grid.Column="2" Text="{DynamicResource Text.CategoriesTags}" Clicked="OnCategoriesClicked" /></Grid>
    <Label Text="{DynamicResource Text.QuickAdd}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Picker Title="{DynamicResource Text.Type}" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding Type}" />
    <Picker Title="{DynamicResource Text.Account}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
    <Picker Title="{DynamicResource Text.CategoryOptional}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:Category" /></Picker.ItemDisplayBinding></Picker>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><VerticalStackLayout><Label Text="{DynamicResource Text.Date}" /><DatePicker Date="{Binding OccurredDate}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{DynamicResource Text.Time}" /><TimePicker Time="{Binding OccurredTime}" /></VerticalStackLayout></Grid>
    <Entry Placeholder="{DynamicResource Text.Amount}" Keyboard="Numeric" Text="{Binding Amount}" SemanticProperties.Description="{DynamicResource Text.TransactionAmountDescription}" />
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="6"><Label Text="{DynamicResource Text.CalculatorKeypad}" Style="{StaticResource SectionTitle}" /><Label LineBreakMode="TailTruncation"><Label.FormattedText><FormattedString><Span Text="{DynamicResource Text.ExpressionPrefix}" /><Span Text="{Binding CalculatorExpression}" /></FormattedString></Label.FormattedText></Label><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="5" ColumnSpacing="5"><Button Text="7" Clicked="OnCalculatorToken" /><Button Grid.Column="1" Text="8" Clicked="OnCalculatorToken" /><Button Grid.Column="2" Text="9" Clicked="OnCalculatorToken" /><Button Grid.Column="3" Text="÷" Clicked="OnCalculatorToken" /><Button Grid.Row="1" Text="4" Clicked="OnCalculatorToken" /><Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnCalculatorToken" /><Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnCalculatorToken" /><Button Grid.Row="1" Grid.Column="3" Text="×" Clicked="OnCalculatorToken" /><Button Grid.Row="2" Text="1" Clicked="OnCalculatorToken" /><Button Grid.Row="2" Grid.Column="1" Text="2" Clicked="OnCalculatorToken" /><Button Grid.Row="2" Grid.Column="2" Text="3" Clicked="OnCalculatorToken" /><Button Grid.Row="2" Grid.Column="3" Text="-" Clicked="OnCalculatorToken" /><Button Grid.Row="3" Text="0" Clicked="OnCalculatorToken" /><Button Grid.Row="3" Grid.Column="1" Text="." Clicked="OnCalculatorToken" /><Button Grid.Row="3" Grid.Column="2" Text="⌫" Clicked="OnCalculatorBackspace" /><Button Grid.Row="3" Grid.Column="3" Text="+" Clicked="OnCalculatorToken" /><Button Grid.Row="4" Grid.ColumnSpan="2" Text="{DynamicResource Text.Clear}" Clicked="OnCalculatorClear" /><Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="{DynamicResource Text.UseResult}" Clicked="OnCalculatorEquals" /></Grid></VerticalStackLayout></Border>
    <Entry Placeholder="{DynamicResource Text.MerchantPayee}" Text="{Binding Merchant}" /><Entry Placeholder="{DynamicResource Text.PaymentMethodOptional}" Text="{Binding PaymentMethod}" /><Entry Placeholder="{DynamicResource Text.LocationOptionalManual}" Text="{Binding ManualLocation}" /><Editor Placeholder="{DynamicResource Text.Note}" AutoSize="TextChanges" Text="{Binding Note}" /><Button Text="{DynamicResource Text.SaveTransaction}" Command="{Binding AddCommand}" />
    <Label Text="{DynamicResource Text.History}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Label Text="{Binding HistoryStatus}" FontSize="12" />
    <CollectionView ItemsSource="{Binding Transactions}" SelectionMode="Single" SelectionChanged="OnTransactionSelected" EmptyView="{DynamicResource Text.NoMatchingTransactions}" HeightRequest="460"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:TransactionListItem"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Merchant}" FontAttributes="Bold" /><Label Text="{Binding AccountName}" /><Label Text="{Binding CategoryName}" /><Label Text="{Binding Note}" FontSize="12" /><Label Text="{Binding OccurredAtUtc, StringFormat='{0:g}'}" FontSize="12" /><Label Text="{DynamicResource Text.TransactionTapHelp}" FontSize="11" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Type}" HorizontalTextAlignment="End" /><Label HorizontalTextAlignment="End"><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Button Text="{DynamicResource Text.LoadMoreTransactions}" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" SemanticProperties.Description="{DynamicResource Text.LoadMoreTransactionsDescription}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
