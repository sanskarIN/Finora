<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.LockPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False"><Grid Padding="28"><VerticalStackLayout VerticalOptions="Center" Spacing="18" MaximumWidthRequest="460"><Label Text="Finora is locked" Style="{StaticResource Title}" HorizontalTextAlignment="Center" /><Label Text="{Binding Status}" HorizontalTextAlignment="Center" SemanticProperties.LiveSetting="Polite" /><Button Text="Unlock with biometrics / Windows Hello" Command="{Binding BiometricCommand}" IsVisible="{Binding CanUseBiometrics}" /><Entry Placeholder="PIN" IsPassword="True" Keyboard="Numeric" MaxLength="12" Text="{Binding Pin}" ReturnType="Done" /><Button Text="Unlock with PIN" Command="{Binding UnlockCommand}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" /></VerticalStackLayout></Grid></ContentPage>
