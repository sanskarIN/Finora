<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.LockPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             x:DataType="local:LockViewModel"
             Shell.NavBarIsVisible="False">
  <Grid Padding="28">
    <VerticalStackLayout VerticalOptions="Center" Spacing="18" MaximumWidthRequest="460">
      <Label Text="{DynamicResource Text.FinoraLocked}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{Binding Status}" HorizontalTextAlignment="Center" SemanticProperties.Description="{DynamicResource Text.FinoraLockStatusDescription}" />
      <Button Text="{DynamicResource Text.UnlockWithBiometrics}" Command="{Binding BiometricCommand}" IsVisible="{Binding CanUseBiometrics}" SemanticProperties.Description="{DynamicResource Text.UnlockWithBiometricsDescription}" />
      <Entry Placeholder="{DynamicResource Text.PinPlaceholder}" IsPassword="True" Keyboard="Numeric" MaxLength="12" Text="{Binding Pin}" ReturnType="Done" SemanticProperties.Description="{DynamicResource Text.PinEntryDescription}" />
      <Button Text="{DynamicResource Text.UnlockWithPin}" Command="{Binding UnlockCommand}" SemanticProperties.Description="{DynamicResource Text.UnlockWithPinDescription}" />
      <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
