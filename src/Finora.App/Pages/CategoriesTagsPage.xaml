<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.CategoriesTagsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             x:DataType="local:CategoriesTagsViewModel"
             Title="{DynamicResource Text.CategoriesTagsTitle}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.CategoriesTagsTitle}" Style="{StaticResource Title}" />
    <Label Text="{DynamicResource Text.CategoriesSection}" Style="{StaticResource SectionTitle}" />
    <Picker Title="{DynamicResource Text.CategoriesSelected}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:CategoryInfo" /></Picker.ItemDisplayBinding></Picker>
    <Entry Placeholder="{DynamicResource Text.CategoriesName}" Text="{Binding CategoryName}" MaxLength="120" />
    <Entry Placeholder="{DynamicResource Text.IconName}" Text="{Binding CategoryIcon}" MaxLength="60" />
    <Picker Title="{DynamicResource Text.CategoriesParentOptional}" ItemsSource="{Binding ActiveCategories}" SelectedItem="{Binding ParentCategory}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:CategoryInfo" /></Picker.ItemDisplayBinding></Picker>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.CategoriesCreate}" Command="{Binding NewCategoryCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.CategoriesUpdateSelected}" Command="{Binding UpdateCategoryCommand}" /></Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.CategoriesMoveUp}" Command="{Binding MoveUpCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.CategoriesMoveDown}" Command="{Binding MoveDownCommand}" /></Grid>
    <Picker Title="{DynamicResource Text.CategoriesMergeTarget}" ItemsSource="{Binding ActiveCategories}" SelectedItem="{Binding MergeTarget}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:CategoryInfo" /></Picker.ItemDisplayBinding></Picker>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.CategoriesMerge}" Command="{Binding MergeCategoryCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.CategoriesArchive}" Command="{Binding ArchiveCategoryCommand}" /><Button Grid.Column="2" Text="{DynamicResource Text.CategoriesRestore}" Command="{Binding RestoreCategoryCommand}" /></Grid>
    <CollectionView ItemsSource="{Binding Categories}" EmptyView="{DynamicResource Text.CategoriesNoItems}" HeightRequest="260"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:CategoryInfo"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.CategoriesParentPrefix}" /><Label Text="{Binding ParentName}" FontSize="12" /></HorizontalStackLayout></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="4"><Label Text="{DynamicResource Text.CategoriesArchivedPrefix}" /><Label Text="{Binding IsArchived}" /></HorizontalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.TagsSection}" Style="{StaticResource SectionTitle}" />
    <Picker Title="{DynamicResource Text.TagsSelected}" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:TagInfo" /></Picker.ItemDisplayBinding></Picker>
    <Entry Placeholder="{DynamicResource Text.TagsName}" Text="{Binding TagName}" MaxLength="80" />
    <Entry Placeholder="{DynamicResource Text.TagsOptionalColor}" Text="{Binding TagColor}" MaxLength="32" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.TagsCreate}" Command="{Binding NewTagCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.CategoriesUpdateSelected}" Command="{Binding UpdateTagCommand}" /></Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.TagsArchive}" Command="{Binding ArchiveTagCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.TagsRestore}" Command="{Binding RestoreTagCommand}" /></Grid>
    <CollectionView ItemsSource="{Binding Tags}" EmptyView="{DynamicResource Text.TagsNoItems}" HeightRequest="220"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:TagInfo"><Grid Padding="10" ColumnDefinitions="*,Auto"><Label Text="{Binding Name}" /><HorizontalStackLayout Grid.Column="1" Spacing="4"><Label Text="{Binding TransactionCount}" /><Label Text="{DynamicResource Text.Transactions}" /></HorizontalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{Binding Status}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
