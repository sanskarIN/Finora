<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.DashboardPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" x:DataType="local:DashboardViewModel" Title="{DynamicResource Text.Dashboard}">
  <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
    <ScrollView><VerticalStackLayout Padding="20" Spacing="16">
      <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.AppName}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" /><Button Grid.Column="1" Text="{DynamicResource Text.HideShow}" Command="{Binding TogglePrivacyCommand}" SemanticProperties.Description="{DynamicResource Text.ToggleAmountPrivacyDescription}" /></Grid>
      <Label Text="{DynamicResource Text.LocalFirstSummary}" />
      <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="{DynamicResource Text.DashboardPeriod}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Picker Title="{DynamicResource Text.ChoosePeriod}" ItemsSource="{Binding PeriodChoices}" SelectedItem="{Binding SelectedPeriod}" SemanticProperties.Description="{DynamicResource Text.DashboardPeriodPickerDescription}"><Picker.ItemDisplayBinding><Binding Path="Label" x:DataType="local:DashboardPeriodChoice" /></Picker.ItemDisplayBinding></Picker><Button Grid.Column="1" Text="{DynamicResource Text.Apply}" Command="{Binding RefreshCommand}" SemanticProperties.Description="{DynamicResource Text.ApplyDashboardPeriodDescription}" /></Grid><Label Text="{Binding PeriodRange}" FontSize="12" /></VerticalStackLayout></Border>
      <Label Text="{Binding CurrencyScope}" FontSize="12" SemanticProperties.Description="{DynamicResource Text.DashboardCurrencyDescription}" />
      <Button Text="{DynamicResource Text.ConfigureDashboardCards}" Command="{Binding ToggleConfigurationCommand}" />
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowConfiguration}"><VerticalStackLayout Spacing="8"><Label Text="{DynamicResource Text.DashboardCards}" Style="{StaticResource SectionTitle}" /><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.CurrentBalance}" /><Switch Grid.Column="1" IsToggled="{Binding ShowBalance}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.IncomeSpendingNetChange}" /><Switch Grid.Column="1" IsToggled="{Binding ShowIncomeExpense}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.RemainingBudget}" /><Switch Grid.Column="1" IsToggled="{Binding ShowBudget}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.UpcomingBillsRecurring}" /><Switch Grid.Column="1" IsToggled="{Binding ShowUpcoming}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.TopSpendingCategories}" /><Switch Grid.Column="1" IsToggled="{Binding ShowCategories}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.SavingsGoals}" /><Switch Grid.Column="1" IsToggled="{Binding ShowGoals}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.RecentTransactions}" /><Switch Grid.Column="1" IsToggled="{Binding ShowRecent}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.CashFlowTrend}" /><Switch Grid.Column="1" IsToggled="{Binding ShowCashFlow}" /></Grid></VerticalStackLayout></Border>
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowBalance}"><VerticalStackLayout><Label Text="{DynamicResource Text.CurrentBalance}" /><Label Text="{Binding TotalBalance}" FontSize="30" FontAttributes="Bold" /></VerticalStackLayout></Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowIncomeExpense}"><Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{DynamicResource Text.Income}" /><Label Text="{Binding Income}" FontAttributes="Bold" /></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{DynamicResource Text.Spending}" /><Label Text="{Binding Expense}" FontAttributes="Bold" /></VerticalStackLayout></Border></Grid>
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowIncomeExpense}"><VerticalStackLayout><Label Text="{DynamicResource Text.NetChange}" /><Label Text="{Binding NetChange}" FontAttributes="Bold" /></VerticalStackLayout></Border><Border Style="{StaticResource Card}" IsVisible="{Binding ShowBudget}"><VerticalStackLayout><Label Text="{DynamicResource Text.BudgetLeft}" /><Label Text="{Binding RemainingBudget}" FontAttributes="Bold" /></VerticalStackLayout></Border>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.Accounts}" Clicked="OnAccountsClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.Reports}" Clicked="OnReportsClicked" /><Button Grid.Column="2" Text="{DynamicResource Text.Recurring}" Clicked="OnRecurringClicked" /></Grid>
      <VerticalStackLayout IsVisible="{Binding ShowUpcoming}" Spacing="6"><Label Text="{DynamicResource Text.UpcomingBillsRecurring}" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding UpcomingItems}" EmptyView="{DynamicResource Text.NoUpcomingRecurring30Days}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:DashboardAmountItem"><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Label}" FontAttributes="Bold" /><Label Text="{Binding Detail}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowGoals}" Spacing="6"><Label Text="{DynamicResource Text.SavingsGoals}" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding Goals}" EmptyView="{DynamicResource Text.NoSavingsGoalsYet}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:DashboardGoalItem"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding ProgressText}" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding PercentText}" FontAttributes="Bold" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowCashFlow}" Spacing="6"><Label Text="{DynamicResource Text.CashFlowTrendSixMonths}" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding CashFlow}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:DashboardAmountItem"><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Label}" /><Label Text="{Binding Detail}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowRecent}" Spacing="6"><Label Text="{DynamicResource Text.RecentTransactions}" Style="{StaticResource SectionTitle}" /><CollectionView x:Name="RecentList" ItemsSource="{Binding RecentTransactions}" SelectionMode="Single" SelectionChanged="OnRecentTransactionSelected" EmptyView="{DynamicResource Text.NoTransactionsSelectedPeriod}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:DashboardTransactionItem"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Label}" FontAttributes="Bold" /><Label Text="{Binding Account}" /><Label Text="{Binding OccurredAt, StringFormat='{0:g}'}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowCategories}" Spacing="6"><Label Text="{DynamicResource Text.TopCategories}" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding TopCategories}" EmptyView="{DynamicResource Text.CategorizedSpendingSelectedPeriod}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:DashboardAmountItem"><Grid Padding="8" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout></ScrollView>
  </RefreshView>
</ContentPage>
