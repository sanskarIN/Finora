<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.DashboardPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Dashboard">
  <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
    <ScrollView><VerticalStackLayout Padding="20" Spacing="16">
      <Grid ColumnDefinitions="*,Auto"><Label Text="Finora" Style="{StaticResource Title}" /><Button Grid.Column="1" Text="Hide / show" Command="{Binding TogglePrivacyCommand}" SemanticProperties.Description="Toggle amount privacy mode" /></Grid>
      <Label Text="Your money stays on this device." />
      <Label Text="{Binding CurrencyScope}" FontSize="12" SemanticProperties.Description="Dashboard reporting currency information" />
      <Button Text="Configure dashboard cards" Command="{Binding ToggleConfigurationCommand}" />
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowConfiguration}"><VerticalStackLayout Spacing="8"><Label Text="Dashboard cards" Style="{StaticResource SectionTitle}" /><Grid ColumnDefinitions="*,Auto"><Label Text="Current balance" /><Switch Grid.Column="1" IsToggled="{Binding ShowBalance}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Income, spending and net change" /><Switch Grid.Column="1" IsToggled="{Binding ShowIncomeExpense}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Remaining budget" /><Switch Grid.Column="1" IsToggled="{Binding ShowBudget}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Upcoming bills and recurring items" /><Switch Grid.Column="1" IsToggled="{Binding ShowUpcoming}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Top spending categories" /><Switch Grid.Column="1" IsToggled="{Binding ShowCategories}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Savings goals" /><Switch Grid.Column="1" IsToggled="{Binding ShowGoals}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Recent transactions" /><Switch Grid.Column="1" IsToggled="{Binding ShowRecent}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Cash-flow trend" /><Switch Grid.Column="1" IsToggled="{Binding ShowCashFlow}" /></Grid></VerticalStackLayout></Border>
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowBalance}"><VerticalStackLayout><Label Text="Current balance" /><Label Text="{Binding TotalBalance}" FontSize="30" FontAttributes="Bold" /></VerticalStackLayout></Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ShowIncomeExpense}"><Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Income" /><Label Text="{Binding Income}" FontAttributes="Bold" /></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Spending" /><Label Text="{Binding Expense}" FontAttributes="Bold" /></VerticalStackLayout></Border></Grid>
      <Border Style="{StaticResource Card}" IsVisible="{Binding ShowIncomeExpense}"><VerticalStackLayout><Label Text="Net change" /><Label Text="{Binding NetChange}" FontAttributes="Bold" /></VerticalStackLayout></Border><Border Style="{StaticResource Card}" IsVisible="{Binding ShowBudget}"><VerticalStackLayout><Label Text="Budget left" /><Label Text="{Binding RemainingBudget}" FontAttributes="Bold" /></VerticalStackLayout></Border>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="Accounts" Clicked="OnAccountsClicked" /><Button Grid.Column="1" Text="Reports" Clicked="OnReportsClicked" /><Button Grid.Column="2" Text="Recurring" Clicked="OnRecurringClicked" /></Grid>
      <VerticalStackLayout IsVisible="{Binding ShowUpcoming}" Spacing="6"><Label Text="Upcoming bills and recurring items" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding UpcomingItems}" EmptyView="No upcoming recurring items in the next 30 days."><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Label}" FontAttributes="Bold" /><Label Text="{Binding Detail}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowGoals}" Spacing="6"><Label Text="Savings goals" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding Goals}" EmptyView="No savings goals yet."><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding ProgressText}" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding PercentText}" FontAttributes="Bold" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowCashFlow}" Spacing="6"><Label Text="Cash-flow trend (last 6 months)" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding CashFlow}"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Label}" /><Label Text="{Binding Detail}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowRecent}" Spacing="6"><Label Text="Recent transactions" Style="{StaticResource SectionTitle}" /><CollectionView x:Name="RecentList" ItemsSource="{Binding RecentTransactions}" SelectionMode="Single" SelectionChanged="OnRecentTransactionSelected" EmptyView="No transactions yet."><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Label}" FontAttributes="Bold" /><Label Text="{Binding Account}" /><Label Text="{Binding OccurredAt, StringFormat='{0:g}'}" FontSize="12" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <VerticalStackLayout IsVisible="{Binding ShowCategories}" Spacing="6"><Label Text="Top categories" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding TopCategories}" EmptyView="Categorized spending appears here."><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><Label Text="{Binding Label}" /><Label Grid.Column="1" Text="{Binding Amount}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>
      <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" SemanticProperties.LiveSetting="Polite" />
    </VerticalStackLayout></ScrollView>
  </RefreshView>
</ContentPage>
