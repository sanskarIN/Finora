<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ReconciliationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             x:DataType="local:ReconciliationViewModel"
             Title="{DynamicResource Text.ReconciliationTitle}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.ReconciliationTitle}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="{DynamicResource Text.ReconciliationNotice}" />
    <Picker Title="{DynamicResource Text.Account}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
    <Entry Placeholder="{DynamicResource Text.ReconciliationStatementBalance}" Keyboard="Numeric" Text="{Binding StatementBalance}" SemanticProperties.Description="{DynamicResource Text.ReconciliationStatementBalanceDescription}" />
    <DatePicker Date="{Binding StatementDate}" />
    <Editor Placeholder="{DynamicResource Text.ReconciliationOptionalNote}" Text="{Binding Note}" AutoSize="TextChanges" />
    <Button Text="{DynamicResource Text.ReconciliationPreview}" Command="{Binding PreviewCommand}" />
    <Border Style="{StaticResource Card}"><Label Text="{Binding PreviewText}" /></Border>
    <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.ReconciliationCreateAdjustment}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding CreateAdjustment}" /></Grid>
    <Button Text="{DynamicResource Text.ReconciliationComplete}" Command="{Binding CompleteCommand}" />
    <Label Text="{DynamicResource Text.ReconciliationHistory}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding History}" EmptyView="{DynamicResource Text.ReconciliationNoHistory}" HeightRequest="260"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:ReconciliationHistoryDisplayItem"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReconciliationStatementPrefix}" FontAttributes="Bold" /><Label Text="{Binding StatementDateUtc, StringFormat='{0:d}'}" FontAttributes="Bold" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReconciliationDifferencePrefix}" /><Label Text="{Binding Difference}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.ReconciliationAdjustmentCreatedPrefix}" /><Label Text="{Binding AdjustmentCreated}" /></HorizontalStackLayout><Label Text="{Binding Note}" FontSize="12" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{Binding Status}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
