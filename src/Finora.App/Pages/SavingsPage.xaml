<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.SavingsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Goals">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Savings goals" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <CollectionView ItemsSource="{Binding Goals}" EmptyView="Create a savings goal below." HeightRequest="280"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><ProgressBar Progress="{Binding Progress}" /><Label><Label.Text><MultiBinding StringFormat="Saved: {0}" Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="CurrentMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label><Label><Label.Text><MultiBinding StringFormat="Target: {0}" Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="TargetMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label><Label Text="{Binding TargetDate, StringFormat='Target date: {0}'}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Planning" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Picker Title="Goal" ItemsSource="{Binding Goals}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedGoal}" />
    <Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Forecast}" /><Label Text="{Binding Milestones}" /></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowCompletionCelebration}"><Label Text="Goal completed — congratulations!" FontAttributes="Bold" HorizontalTextAlignment="Center" /></Border>
    <Label Text="Create goal" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Entry Placeholder="Goal name" Text="{Binding Name}" /><Entry Placeholder="Icon name" Text="{Binding Icon}" /><Entry Placeholder="Target amount" Keyboard="Numeric" Text="{Binding Target}" SemanticProperties.Description="Savings target in major currency units" /><Entry Placeholder="Starting amount" Keyboard="Numeric" Text="{Binding Starting}" SemanticProperties.Description="Starting savings amount in major currency units" /><DatePicker Date="{Binding TargetDate}" /><Editor Placeholder="Notes" Text="{Binding Notes}" AutoSize="TextChanges" /><Button Text="Create goal" Command="{Binding AddGoalCommand}" />
    <Label Text="Add contribution or withdrawal" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Entry Placeholder="Amount; use a minus sign for withdrawal" Keyboard="Numeric" Text="{Binding Contribution}" /><Picker Title="Link an existing account transaction (optional)" ItemsSource="{Binding RecentTransactions}" ItemDisplayBinding="{Binding Merchant}" SelectedItem="{Binding LinkedTransaction}" /><Entry Placeholder="Contribution note" Text="{Binding ContributionNote}" /><Button Text="Apply to selected goal" Command="{Binding ContributeCommand}" />
    <Label Text="The completion message uses no forced animation, so reduced-motion preferences are respected." FontSize="12" /><Label Text="{Binding Status}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
