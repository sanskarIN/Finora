<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.SavingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             x:DataType="local:SavingsViewModel"
             Title="{DynamicResource Text.Goals}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.SavingsGoals}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <CollectionView ItemsSource="{Binding Goals}" EmptyView="{DynamicResource Text.CreateSavingsGoalBelow}" HeightRequest="280"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:SavingsGoalSnapshot"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><ProgressBar Progress="{Binding Progress}" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.Saved}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="CurrentMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.Target}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="TargetMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.TargetDate}" /><Label Text="{Binding TargetDate}" /></HorizontalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.Planning}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Picker Title="{DynamicResource Text.Goal}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:SavingsGoalSnapshot" /></Picker.ItemDisplayBinding></Picker>
    <Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Forecast}" /><Label Text="{Binding Milestones}" /></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}" IsVisible="{Binding ShowCompletionCelebration}"><Label Text="{DynamicResource Text.GoalCompletedCongratulations}" FontAttributes="Bold" HorizontalTextAlignment="Center" /></Border>
    <Label Text="{DynamicResource Text.CreateGoal}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Entry Placeholder="{DynamicResource Text.GoalName}" Text="{Binding Name}" /><Entry Placeholder="{DynamicResource Text.IconName}" Text="{Binding Icon}" /><Entry Placeholder="{DynamicResource Text.TargetAmount}" Keyboard="Numeric" Text="{Binding Target}" SemanticProperties.Description="{DynamicResource Text.SavingsTargetDescription}" /><Entry Placeholder="{DynamicResource Text.StartingAmount}" Keyboard="Numeric" Text="{Binding Starting}" SemanticProperties.Description="{DynamicResource Text.StartingSavingsDescription}" /><DatePicker Date="{Binding TargetDate}" /><Editor Placeholder="{DynamicResource Text.Notes}" Text="{Binding Notes}" AutoSize="TextChanges" /><Button Text="{DynamicResource Text.CreateGoal}" Command="{Binding AddGoalCommand}" />
    <Label Text="{DynamicResource Text.AddContributionWithdrawal}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Entry Placeholder="{DynamicResource Text.ContributionAmountHint}" Keyboard="Numeric" Text="{Binding Contribution}" /><Picker Title="{DynamicResource Text.LinkExistingTransactionOptional}" ItemsSource="{Binding RecentTransactions}" SelectedItem="{Binding LinkedTransaction}"><Picker.ItemDisplayBinding><Binding Path="Merchant" x:DataType="application:TransactionListItem" /></Picker.ItemDisplayBinding></Picker><Entry Placeholder="{DynamicResource Text.ContributionNote}" Text="{Binding ContributionNote}" /><Button Text="{DynamicResource Text.ApplySelectedGoal}" Command="{Binding ContributeCommand}" />
    <Label Text="{DynamicResource Text.ReducedMotionGoalNotice}" FontSize="12" /><Label Text="{Binding Status}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
