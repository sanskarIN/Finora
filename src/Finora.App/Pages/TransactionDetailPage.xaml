<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.TransactionDetailPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application" xmlns:domain="clr-namespace:Finora.Domain;assembly=Finora.Domain" x:DataType="local:TransactionDetailViewModel" Title="{DynamicResource Text.TransactionDetailTitle}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.TransactionDetailTitle}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="{DynamicResource Text.TransactionDetailNotice}" />
    <Picker Title="{DynamicResource Text.Type}" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding Type}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="{DynamicResource Text.Account}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
    <Picker Title="{DynamicResource Text.TransactionDetailCategory}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:Category" /></Picker.ItemDisplayBinding></Picker>
    <Entry Placeholder="{DynamicResource Text.Amount}" Keyboard="Numeric" Text="{Binding Amount}" SemanticProperties.Description="{DynamicResource Text.TransactionAmountDescription}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><DatePicker Date="{Binding TransactionDate}" /><TimePicker Grid.Column="1" Time="{Binding TransactionTime}" /></Grid>
    <Entry Placeholder="{DynamicResource Text.MerchantPayee}" Text="{Binding Merchant}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" /><Entry Placeholder="{DynamicResource Text.TransactionDetailPaymentMethod}" Text="{Binding PaymentMethod}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" /><Entry Placeholder="{DynamicResource Text.TransactionDetailManualLocation}" Text="{Binding ManualLocation}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" /><Editor Placeholder="{DynamicResource Text.Note}" AutoSize="TextChanges" Text="{Binding Note}" />
    <Label Text="{DynamicResource Text.TransactionDetailSplits}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="{DynamicResource Text.TransactionDetailSplitCategory}" ItemsSource="{Binding Categories}" SelectedItem="{Binding NewSplitCategory}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:Category" /></Picker.ItemDisplayBinding></Picker>
    <Entry Placeholder="{DynamicResource Text.TransactionDetailSplitAmount}" Keyboard="Numeric" Text="{Binding NewSplitAmount}" SemanticProperties.Description="{DynamicResource Text.TransactionDetailSplitAmountDescription}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" /><Entry Placeholder="{DynamicResource Text.TransactionDetailSplitNote}" Text="{Binding NewSplitNote}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" /><Button Text="{DynamicResource Text.TransactionDetailAddSplit}" Command="{Binding AddSplitCommand}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="{DynamicResource Text.TransactionDetailSelectedSplit}" ItemsSource="{Binding Splits}" SelectedItem="{Binding SelectedSplit}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><Picker.ItemDisplayBinding><Binding Path="CategoryName" x:DataType="local:SplitEditorItem" /></Picker.ItemDisplayBinding></Picker>
    <Button Text="{DynamicResource Text.TransactionDetailRemoveSplit}" Command="{Binding RemoveSplitCommand}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <CollectionView ItemsSource="{Binding Splits}" HeightRequest="180" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SplitEditorItem"><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding CategoryName}" FontAttributes="Bold" /><Label Text="{Binding Note}" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding DisplayAmount}" HorizontalTextAlignment="End" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="{DynamicResource Text.TransactionDetailTags}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <CollectionView ItemsSource="{Binding Tags}" HeightRequest="180" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SelectableTagItem"><Grid Padding="8" ColumnDefinitions="Auto,*"><CheckBox IsChecked="{Binding IsSelected}" /><Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Button Text="{DynamicResource Text.TransactionDetailSaveChanges}" Command="{Binding SaveCommand}" />
    <Label Text="{DynamicResource Text.TransactionDetailReceipts}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.TransactionDetailAddReceipt}" Clicked="OnAddAttachmentClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.TransactionDetailOpenSelected}" Clicked="OnOpenAttachmentClicked" /></Grid>
    <Picker Title="{DynamicResource Text.TransactionDetailSelectedAttachment}" ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}"><Picker.ItemDisplayBinding><Binding Path="FileName" x:DataType="application:AttachmentInfo" /></Picker.ItemDisplayBinding></Picker>
    <Button Text="{DynamicResource Text.TransactionDetailDeleteAttachment}" Clicked="OnDeleteAttachmentClicked" />
    <Label Text="{DynamicResource Text.TransactionDetailEditHistory}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding Revisions}" EmptyView="{DynamicResource Text.TransactionDetailNoRevisions}" HeightRequest="220"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:TransactionRevisionInfo"><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding ChangeKind}" FontAttributes="Bold" /><Label Text="{Binding ChangedAtUtc, StringFormat='{0:g}'}" /><Label Text="{Binding Summary}" FontSize="12" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.TransactionDetailDeleteUndo}" Clicked="OnDeleteOrRestoreClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.TransactionDetailRefresh}" Clicked="OnRefreshClicked" /></Grid><Label Text="{Binding Status}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
