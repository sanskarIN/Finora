<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.TransactionDetailPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Transaction details">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Transaction details" Style="{StaticResource Title}" />
    <Label Text="Linked transfers keep both sides balanced. Standard transactions preserve a local revision snapshot before every edit." />
    <Picker Title="Type" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding Type}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="Account" ItemsSource="{Binding Accounts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Account}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="Category" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Category}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Entry Placeholder="Amount" Keyboard="Numeric" Text="{Binding Amount}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><DatePicker Date="{Binding TransactionDate}" /><TimePicker Grid.Column="1" Time="{Binding TransactionTime}" /></Grid>
    <Entry Placeholder="Merchant or payee" Text="{Binding Merchant}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Entry Placeholder="Payment method" Text="{Binding PaymentMethod}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Entry Placeholder="Manually entered location" Text="{Binding ManualLocation}" IsEnabled="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Editor Placeholder="Note" AutoSize="TextChanges" Text="{Binding Note}" />
    <Label Text="Splits" Style="{StaticResource SectionTitle}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="Split category" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding NewSplitCategory}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Entry Placeholder="Split amount" Keyboard="Numeric" Text="{Binding NewSplitAmount}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Entry Placeholder="Split note" Text="{Binding NewSplitNote}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Button Text="Add split" Command="{Binding AddSplitCommand}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Picker Title="Selected split" ItemsSource="{Binding Splits}" ItemDisplayBinding="{Binding CategoryName}" SelectedItem="{Binding SelectedSplit}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <Button Text="Remove selected split" Command="{Binding RemoveSplitCommand}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <CollectionView ItemsSource="{Binding Splits}" HeightRequest="180" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding CategoryName}" FontAttributes="Bold" /><Label Text="{Binding Note}" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding AmountMajor}" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Tags" Style="{StaticResource SectionTitle}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}" />
    <CollectionView ItemsSource="{Binding Tags}" HeightRequest="180" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnDefinitions="Auto,*"><CheckBox IsChecked="{Binding IsSelected}" /><Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Button Text="Save changes" Command="{Binding SaveCommand}" />
    <Label Text="Receipt attachments" Style="{StaticResource SectionTitle}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Add receipt" Clicked="OnAddAttachmentClicked" /><Button Grid.Column="1" Text="Open selected" Clicked="OnOpenAttachmentClicked" /></Grid>
    <Picker Title="Selected attachment" ItemsSource="{Binding Attachments}" ItemDisplayBinding="{Binding FileName}" SelectedItem="{Binding SelectedAttachment}" />
    <Button Text="Delete selected attachment" Clicked="OnDeleteAttachmentClicked" />
    <Label Text="Edit history" Style="{StaticResource SectionTitle}" />
    <CollectionView ItemsSource="{Binding Revisions}" EmptyView="No prior revisions." HeightRequest="220"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding ChangeKind}" FontAttributes="Bold" /><Label Text="{Binding ChangedAtUtc, StringFormat='{0:g}'}" /><Label Text="{Binding Summary}" FontSize="12" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Delete / undo" Clicked="OnDeleteOrRestoreClicked" /><Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" /></Grid>
    <Label Text="{Binding Status}" SemanticProperties.LiveSetting="Polite" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
