<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.RecurringPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             xmlns:domain="clr-namespace:Finora.Domain;assembly=Finora.Domain"
             x:DataType="local:RecurringViewModel"
             Title="{DynamicResource Text.Recurring}">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <Label Text="{DynamicResource Text.RecurringItems}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{DynamicResource Text.RecurringWorkflowNotice}" />
      <Button Text="{DynamicResource Text.RecurringPrepareNow}" Command="{Binding ProcessNowCommand}" />
      <Label Text="{Binding ProcessingResult}" />
      <Label Text="{DynamicResource Text.RecurringRules}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
      <Picker Title="{DynamicResource Text.RecurringChooseRule}" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" SemanticProperties.Description="{DynamicResource Text.RecurringChooseRuleDescription}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:RecurrenceRule" /></Picker.ItemDisplayBinding></Picker>
      <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="4"><Label Text="{Binding SelectedRule.Name}" FontAttributes="Bold" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringStatus}" /><Label Text="{Binding SelectedRule.Status}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringType}" /><Label Text="{Binding SelectedRule.TransactionType}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringFrequency}" /><Label Text="{Binding SelectedRule.Frequency}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringScheduledAmount}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="SelectedRule.AmountMinor" /><Binding Path="SelectedRule.Currency" /></MultiBinding></Label.Text></Label></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringNextDue}" /><Label Text="{Binding SelectedRule.NextDueOn}" /></HorizontalStackLayout></VerticalStackLayout></Border>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.RecurringPause}" Command="{Binding PauseRuleCommand}" IsEnabled="{Binding CanPauseSelectedRule}" SemanticProperties.Description="{DynamicResource Text.RecurringPauseDescription}" /><Button Grid.Column="1" Text="{DynamicResource Text.RecurringResume}" Command="{Binding ResumeRuleCommand}" IsEnabled="{Binding CanResumeSelectedRule}" SemanticProperties.Description="{DynamicResource Text.RecurringResumeDescription}" /><Button Grid.Column="2" Text="{DynamicResource Text.RecurringArchive}" Command="{Binding ArchiveRuleCommand}" IsEnabled="{Binding CanArchiveSelectedRule}" SemanticProperties.Description="{DynamicResource Text.RecurringArchiveDescription}" /></Grid>
      <CollectionView ItemsSource="{Binding Rules}" EmptyView="{DynamicResource Text.RecurringNoItems}" HeightRequest="220"><CollectionView.ItemTemplate><DataTemplate x:DataType="domain:RecurrenceRule"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding TransactionType}" /><Label Text="{Binding Frequency}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" HorizontalOptions="End"><Label Text="{Binding Status}" HorizontalTextAlignment="End" /><Label HorizontalTextAlignment="End"><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringNext}" /><Label Text="{Binding NextDueOn}" /></HorizontalStackLayout></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="{DynamicResource Text.RecurringOccurrenceWorkflow}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
      <Picker Title="{DynamicResource Text.RecurringChooseOccurrence}" ItemsSource="{Binding Occurrences}" SelectedItem="{Binding SelectedOccurrence}"><Picker.ItemDisplayBinding><Binding Path="RuleName" x:DataType="application:RecurrenceOccurrenceInfo" /></Picker.ItemDisplayBinding></Picker>
      <Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding SelectedOccurrence.RuleName}" FontAttributes="Bold" /><Label Text="{Binding SelectedOccurrence.Status}" /><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringDue}" /><Label Text="{Binding SelectedOccurrence.DueOn}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringPostponedTo}" /><Label Text="{Binding SelectedOccurrence.PostponedTo}" /></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringScheduled}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="SelectedOccurrence.AmountMinor" /><Binding Path="SelectedOccurrence.Currency" /></MultiBinding></Label.Text></Label></HorizontalStackLayout><HorizontalStackLayout Spacing="4"><Label Text="{DynamicResource Text.RecurringPaid}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="SelectedOccurrence.PaidAmountMinor" /><Binding Path="SelectedOccurrence.Currency" /></MultiBinding></Label.Text></Label></HorizontalStackLayout></VerticalStackLayout></Border>
      <Entry Placeholder="{DynamicResource Text.RecurringPaidAmount}" Keyboard="Numeric" Text="{Binding PaidAmount}" />
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.RecurringMarkPaidPartial}" Command="{Binding MarkPaidCommand}" /><Button Grid.Column="1" Text="{DynamicResource Text.RecurringSkip}" Command="{Binding SkipCommand}" /><Button Grid.Column="2" Text="{DynamicResource Text.RecurringReopen}" Command="{Binding ReopenCommand}" IsEnabled="{Binding CanReopenSelectedOccurrence}" SemanticProperties.Description="{DynamicResource Text.RecurringReopenDescription}" /></Grid>
      <DatePicker Date="{Binding PostponeDate}" /><Button Text="{DynamicResource Text.RecurringPostponeSelectedDate}" Command="{Binding PostponeCommand}" />
      <Label Text="{DynamicResource Text.RecurringCreateItem}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
      <Entry Placeholder="{DynamicResource Text.RecurringName}" Text="{Binding Name}" /><Picker Title="{DynamicResource Text.Type}" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" /><Picker Title="{DynamicResource Text.RecurringFrequencyTitle}" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" /><Label Text="{DynamicResource Text.RecurringRepeatInterval}" /><Stepper Minimum="1" Maximum="365" Value="{Binding Interval}" /><Label Text="{Binding Interval}" />
      <Picker Title="{DynamicResource Text.Account}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
      <Picker Title="{DynamicResource Text.RecurringDestinationAccount}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding DestinationAccount}" IsVisible="{Binding IsTransfer}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
      <Picker Title="{DynamicResource Text.RecurringCategory}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBoolConverter}}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="domain:Category" /></Picker.ItemDisplayBinding></Picker>
      <Entry Placeholder="{DynamicResource Text.Amount}" Keyboard="Numeric" Text="{Binding Amount}" SemanticProperties.Description="{DynamicResource Text.RecurringAmountDescription}" /><Entry Placeholder="{DynamicResource Text.RecurringMerchantPayee}" Text="{Binding Merchant}" /><Editor Placeholder="{DynamicResource Text.Note}" Text="{Binding Note}" AutoSize="TextChanges" /><Label Text="{DynamicResource Text.RecurringStartDate}" /><DatePicker Date="{Binding StartsOn}" /><Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.RecurringUseEndDate}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding HasEndDate}" /></Grid><DatePicker Date="{Binding EndsOn}" IsEnabled="{Binding HasEndDate}" /><Label Text="{DynamicResource Text.RecurringGracePeriodDays}" /><Stepper Minimum="0" Maximum="90" Value="{Binding GracePeriodDays}" /><Label Text="{Binding GracePeriodDays}" /><Label Text="{DynamicResource Text.RecurringReminderLeadMinutes}" /><Entry Keyboard="Numeric" Text="{Binding ReminderMinutesBefore}" /><Button Text="{DynamicResource Text.RecurringSaveItem}" Command="{Binding AddCommand}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
