<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.AccountsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             x:DataType="local:AccountsViewModel"
             Title="{DynamicResource Text.Accounts}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.Accounts}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <CollectionView x:Name="AccountList" ItemsSource="{Binding Accounts}" SelectionMode="Single" SelectionChanged="OnAccountSelected" EmptyView="{DynamicResource Text.AccountsEmpty}" HeightRequest="280">
      <CollectionView.ItemTemplate><DataTemplate x:DataType="application:AccountSummary"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Type}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Currency}" HorizontalTextAlignment="End" /><Label HorizontalTextAlignment="End"><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="BalanceMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.ReconcileAccount}" Clicked="OnReconcileClicked" /><Button Grid.Column="1" Text="{DynamicResource Text.CategoriesTags}" Clicked="OnAccountCategoriesClicked" /></Grid>
    <Label Text="{DynamicResource Text.AddAccount}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Entry Placeholder="{DynamicResource Text.AccountName}" Text="{Binding Name}" />
    <Picker Title="{DynamicResource Text.AccountType}" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding AccountType}" />
    <Entry Placeholder="{DynamicResource Text.OpeningBalance}" Keyboard="Numeric" Text="{Binding OpeningBalance}" SemanticProperties.Description="{DynamicResource Text.OpeningBalanceMajorDescription}" />
    <Button Text="{DynamicResource Text.AddAccount}" Command="{Binding AddAccountCommand}" />
    <Label Text="{DynamicResource Text.TransferBetweenAccounts}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Picker Title="{DynamicResource Text.From}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SourceAccount}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
    <Picker Title="{DynamicResource Text.To}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding DestinationAccount}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
    <Entry Placeholder="{DynamicResource Text.Amount}" Keyboard="Numeric" Text="{Binding TransferAmount}" SemanticProperties.Description="{DynamicResource Text.TransferAmountDescription}" />
    <Entry Placeholder="{DynamicResource Text.OptionalNote}" Text="{Binding TransferNote}" />
    <Button Text="{DynamicResource Text.Transfer}" Command="{Binding TransferCommand}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
