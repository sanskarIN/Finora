<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.BudgetsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Budgets">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="Budgets" Style="{StaticResource Title}" />
    <CollectionView ItemsSource="{Binding Budgets}" EmptyView="No budgets for this period." HeightRequest="260">
      <CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Currency}" /><Label Text="{Binding PlannedMinor, StringFormat='Planned: {0} minor'}" /><Label Text="{Binding ActualMinor, StringFormat='Actual: {0} minor'}" /><Label Text="{Binding WarningThresholdPercent, StringFormat='Warning at {0}%'}" /></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
    <Label Text="Create budget" Style="{StaticResource SectionTitle}" />
    <Entry Placeholder="Budget name" Text="{Binding Name}" />
    <Entry Placeholder="Limit" Keyboard="Numeric" Text="{Binding Limit}" />
    <Picker Title="Category (leave empty for overall)" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Category}" />
    <Grid ColumnDefinitions="*,Auto"><Label Text="Rollover unused budget" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding Rollover}" /></Grid>
    <Label Text="Warning threshold (%)" />
    <Slider Minimum="1" Maximum="100" Value="{Binding WarningThreshold}" />
    <Label Text="{Binding WarningThreshold, StringFormat='{0}%'}" />
    <Button Text="Save budget" Command="{Binding AddCommand}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
