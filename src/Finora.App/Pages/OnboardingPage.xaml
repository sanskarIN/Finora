<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.OnboardingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             x:DataType="local:OnboardingViewModel"
             Shell.NavBarIsVisible="False">
  <ScrollView><VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="720">
    <Label Text="{DynamicResource Text.WelcomeToFinora}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="{DynamicResource Text.LocalFirstPrivacy}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Label Text="{DynamicResource Text.LocalFirstPrivacyBody}" /></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}" Stroke="{StaticResource Primary}" StrokeThickness="2" SemanticProperties.Description="{DynamicResource Text.SupportFinoraCardDescription}"><VerticalStackLayout Spacing="10"><Image Source="bmc_support.svg" Aspect="AspectFit" HeightRequest="110" SemanticProperties.Description="{DynamicResource Text.SupportFinoraImageDescription}" /><Label Text="{DynamicResource Text.SupportFinoraDevelopment}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" /><Label Text="{DynamicResource Text.SupportFinoraBody}" /><Button Text="{DynamicResource Text.BuyMeCoffeeButton}" Clicked="OnOnboardingBuyMeACoffeeClicked" SemanticProperties.Description="{DynamicResource Text.BuyMeCoffeeBrowserDescription}" /></VerticalStackLayout></Border>
    <Label Text="{DynamicResource Text.DefaultCurrency}" /><Entry Text="{Binding Currency}" Placeholder="INR" MaxLength="8" SemanticProperties.Description="{DynamicResource Text.DefaultCurrencyDescription}" />
    <Label Text="{DynamicResource Text.Locale}" /><Entry Text="{Binding Locale}" Placeholder="en-IN" MaxLength="20" SemanticProperties.Description="{DynamicResource Text.LocaleDescription}" />
    <Label Text="{DynamicResource Text.FinancialMonthStartDay}" /><Stepper Minimum="1" Maximum="28" Value="{Binding MonthStart}" /><Label Text="{Binding MonthStart}" SemanticProperties.Description="{DynamicResource Text.SelectedFinancialMonthStartDay}" />
    <Label Text="{DynamicResource Text.OptionalOpeningBalance}" /><Entry Text="{Binding OpeningBalance}" Keyboard="Numeric" SemanticProperties.Description="{DynamicResource Text.OpeningBalanceDescription}" />
    <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.SampleDataOptIn}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding SampleData}" SemanticProperties.Description="{DynamicResource Text.SampleDataDescription}" /></Grid>
    <Label Text="{DynamicResource Text.OnboardingSharingNotice}" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{DynamicResource Text.Privacy}" Clicked="OnOnboardingPrivacyClicked" SemanticProperties.Description="{DynamicResource Text.PrivacyDescription}" /><Button Grid.Column="1" Text="{DynamicResource Text.Terms}" Clicked="OnOnboardingTermsClicked" SemanticProperties.Description="{DynamicResource Text.TermsDescription}" /></Grid>
    <Button Text="{DynamicResource Text.StartUsingFinora}" Command="{Binding FinishCommand}" SemanticProperties.Description="{DynamicResource Text.StartUsingFinoraDescription}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
