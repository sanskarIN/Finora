<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ImportPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Finora.App"
             xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application"
             x:DataType="local:ImportViewModel"
             Title="{DynamicResource Text.ImportCsvTitle}">
  <ScrollView><VerticalStackLayout Padding="20" Spacing="14">
    <Label Text="{DynamicResource Text.ImportCsvTitle}" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="{DynamicResource Text.ImportValidationNotice}" />
    <Button Text="{DynamicResource Text.ImportChooseCsv}" Clicked="OnChooseCsvClicked" />
    <Label Text="{Binding FileName}" FontAttributes="Bold" />
    <Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border>
    <Label Text="{DynamicResource Text.ImportColumnMapping}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <Label Text="{DynamicResource Text.ImportRequiredMappings}" FontAttributes="Bold" />
    <Picker Title="{DynamicResource Text.ImportDateColumn}" ItemsSource="{Binding Headers}" SelectedItem="{Binding DateColumn}" />
    <Picker Title="{DynamicResource Text.ImportTypeColumn}" ItemsSource="{Binding Headers}" SelectedItem="{Binding TypeColumn}" />
    <Picker Title="{DynamicResource Text.ImportAmountColumn}" ItemsSource="{Binding Headers}" SelectedItem="{Binding AmountColumn}" />
    <Picker Title="{DynamicResource Text.ImportAccountColumn}" ItemsSource="{Binding Headers}" SelectedItem="{Binding AccountColumn}" />
    <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.ImportAmountMinorUnits}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding AmountIsMinorUnits}" /></Grid>
    <Label Text="{DynamicResource Text.ImportOptionalMappings}" FontAttributes="Bold" />
    <Picker Title="{DynamicResource Text.ImportCurrencyColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding CurrencyColumn}" />
    <Picker Title="{DynamicResource Text.ImportCategoryColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding CategoryColumn}" />
    <Picker Title="{DynamicResource Text.ImportMerchantColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding MerchantColumn}" />
    <Picker Title="{DynamicResource Text.ImportNoteColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding NoteColumn}" />
    <Picker Title="{DynamicResource Text.ImportPaymentMethodColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding PaymentMethodColumn}" />
    <Picker Title="{DynamicResource Text.ImportManualLocationColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding LocationColumn}" />
    <Picker Title="{DynamicResource Text.ImportTransferGroupColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding TransferGroupColumn}" />
    <Picker Title="{DynamicResource Text.ImportCounterpartyAccountColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding CounterpartyAccountColumn}" />
    <Picker Title="{DynamicResource Text.ImportTagsColumn}" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding TagsColumn}" />
    <Button Text="{DynamicResource Text.ImportRevalidate}" Command="{Binding RevalidateCommand}" />
    <Picker Title="{DynamicResource Text.ImportFallbackAccount}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding FallbackAccount}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker>
    <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.ImportCreateMissingCategories}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding CreateMissingCategories}" /></Grid>
    <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource Text.ImportSkipDuplicates}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding SkipDuplicates}" /></Grid>
    <Label Text="{DynamicResource Text.ImportPreview}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
    <CollectionView ItemsSource="{Binding PreviewRows}" EmptyView="{DynamicResource Text.ImportNoPreviewRows}" HeightRequest="360"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:CsvImportPreviewRow"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="{Binding RowNumber, StringFormat='#{0}'}" /><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Type}" FontAttributes="Bold" /><Label Text="{Binding Account}" /><Label Text="{Binding Category}" /><Label Text="{Binding Merchant}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label><Label Text="{Binding Error}" TextColor="{StaticResource Danger}" /></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Button Text="{DynamicResource Text.ImportWithMapping}" Command="{Binding ImportCommand}" IsEnabled="{Binding HasFile}" />
    <Label Text="{Binding Status}" />
    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" />
  </VerticalStackLayout></ScrollView>
</ContentPage>
