<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Finora.App.ImportPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Finora.App" xmlns:application="clr-namespace:Finora.Application;assembly=Finora.Application" x:DataType="local:ImportViewModel" Title="Import CSV"><ScrollView><VerticalStackLayout Padding="20" Spacing="14"><Label Text="Import CSV" Style="{StaticResource Title}" /><Label Text="Finora validates CSV structure before writing anything. The import itself is transactional; invalid rows are reported instead of silently guessed." /><Button Text="Choose CSV file" Clicked="OnChooseCsvClicked" /><Label Text="{Binding FileName}" FontAttributes="Bold" /><Border Style="{StaticResource Card}"><Label Text="{Binding Summary}" /></Border><Label Text="Column mapping" Style="{StaticResource SectionTitle}" /><Label Text="Required mappings" FontAttributes="Bold" /><Picker Title="Date column" ItemsSource="{Binding Headers}" SelectedItem="{Binding DateColumn}" /><Picker Title="Type column" ItemsSource="{Binding Headers}" SelectedItem="{Binding TypeColumn}" /><Picker Title="Amount column" ItemsSource="{Binding Headers}" SelectedItem="{Binding AmountColumn}" /><Picker Title="Account column" ItemsSource="{Binding Headers}" SelectedItem="{Binding AccountColumn}" /><Grid ColumnDefinitions="*,Auto"><Label Text="Amount values are already minor units" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding AmountIsMinorUnits}" /></Grid><Label Text="Optional mappings" FontAttributes="Bold" /><Picker Title="Currency" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding CurrencyColumn}" /><Picker Title="Category" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding CategoryColumn}" /><Picker Title="Merchant / payee" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding MerchantColumn}" /><Picker Title="Note" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding NoteColumn}" /><Picker Title="Payment method" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding PaymentMethodColumn}" /><Picker Title="Manual location" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding LocationColumn}" /><Picker Title="Transfer group" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding TransferGroupColumn}" /><Picker Title="Counterparty account" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding CounterpartyAccountColumn}" /><Picker Title="Tags" ItemsSource="{Binding OptionalHeaders}" SelectedItem="{Binding TagsColumn}" /><Button Text="Revalidate CSV structure" Command="{Binding RevalidateCommand}" /><Picker Title="Fallback account for blank/unknown account rows" ItemsSource="{Binding Accounts}" SelectedItem="{Binding FallbackAccount}"><Picker.ItemDisplayBinding><Binding Path="Name" x:DataType="application:AccountSummary" /></Picker.ItemDisplayBinding></Picker><Grid ColumnDefinitions="*,Auto"><Label Text="Create missing categories" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding CreateMissingCategories}" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Skip likely duplicates" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding SkipDuplicates}" /></Grid><Label Text="Preview" Style="{StaticResource SectionTitle}" /><CollectionView ItemsSource="{Binding PreviewRows}" EmptyView="No preview rows yet." HeightRequest="360"><CollectionView.ItemTemplate><DataTemplate x:DataType="application:CsvImportPreviewRow"><Border Style="{StaticResource Card}" Margin="0,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="{Binding RowNumber, StringFormat='#{0}'}" /><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Type}" FontAttributes="Bold" /><Label Text="{Binding Account}" /><Label Text="{Binding Category}" /><Label Text="{Binding Merchant}" /><Label><Label.Text><MultiBinding Converter="{StaticResource PrivacyMoneyConverter}"><Binding Path="AmountMinor" /><Binding Path="Currency" /></MultiBinding></Label.Text></Label><Label Text="{Binding Error}" TextColor="{StaticResource Danger}" /></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Button Text="Import with selected mapping" Command="{Binding ImportCommand}" IsEnabled="{Binding HasFile}" /><Label Text="{Binding Status}" /><Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" /></VerticalStackLayout></ScrollView></ContentPage>
